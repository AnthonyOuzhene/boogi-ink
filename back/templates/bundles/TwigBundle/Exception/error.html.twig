{#
    Utilisées par Symfony EN PRODUCTION seulement (error404, error403, sinon ce fichier) ;
    en dev, page de débogage à la place. Aperçu : /_error/404, /_error/403, /_error/500.
    Les erreurs de /api restent en JSON.

    Sécurité : un visiteur non connecté ne voit JAMAIS l'adresse du backoffice.
#}
<!doctype html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex">
    <title>{% block title %}Erreur{% endblock %} — Boogi'ink</title>
    <link rel="icon" href="{{ asset('admin-assets/logo.png') }}">
    <style>
        :root {
            --bg: #0b1215;
            --surface: #131d22;
            --line: #23323a;
            --text: #e6f4f6;
            --muted: #a9bcc1;
            --cyan: #22d3ee;
            --pink: #ff1493;
            --ink: #041014;
        }
        * { box-sizing: border-box; }
        body {
            margin: 0;
            min-height: 100vh;
            display: grid;
            place-items: center;
            padding: 24px;
            background:
                radial-gradient(ellipse 60% 50% at 50% 30%, rgba(34, 211, 238, 0.08), transparent 70%),
                var(--bg);
            color: var(--text);
            font: 400 17px/1.6 system-ui, -apple-system, "Segoe UI", sans-serif;
        }
        .error {
            width: min(560px, 100%);
            text-align: center;
        }
        .error__mark {
            position: relative;
            display: inline-block;
            line-height: 0;
        }
        .error__logo {
            width: 64px;
            height: 64px;
            border-radius: 50%;
        }
        .error__ring {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            overflow: visible;
            transform: rotate(-90deg); /* départ en haut du cercle */
        }
        .error__ring circle {
            fill: none;
            stroke: var(--cyan);
            stroke-width: 2;
            vector-effect: non-scaling-stroke;
            stroke-dasharray: 100; /* pathLength="100" : tracé complet = 100 */
            stroke-dashoffset: 0;
        }
        @media (prefers-reduced-motion: no-preference) {
            .error__ring circle { animation: logo-trace 1.2s ease-in-out 0.2s both; }
        }
        @keyframes logo-trace {
            from { stroke-dashoffset: 100; }
            to { stroke-dashoffset: 0; }
        }
        .error__code {
            margin: 24px 0 0;
            font: 400 clamp(96px, 22vw, 160px)/0.9 Impact, "Arial Narrow Bold", sans-serif;
            letter-spacing: 0.02em;
            color: var(--cyan);
            text-shadow: 0 0 24px rgba(34, 211, 238, 0.45);
        }
        .error__title {
            margin: 16px 0 8px;
            font: 400 clamp(28px, 6vw, 40px)/1.1 Impact, "Arial Narrow Bold", sans-serif;
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }
        .error__text {
            margin: 0 auto 32px;
            max-width: 440px;
            color: var(--muted);
        }
        .error__note {
            display: inline-block;
            margin-bottom: 28px;
            color: var(--pink);
            font: 400 20px/1.2 "Marker Felt", "Comic Sans MS", cursive;
            transform: rotate(-3deg);
        }
        .error__actions {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 12px;
        }
        .btn {
            display: inline-flex;
            align-items: center;
            padding: 14px 26px;
            border-radius: 999px;
            border: 1px solid transparent;
            font-weight: 600;
            text-decoration: none;
            transition: background-color 0.2s, color 0.2s, border-color 0.2s;
        }
        .btn--primary { background: var(--cyan); color: var(--ink); }
        .btn--primary:hover { background: #67e8f9; }
        .btn--ghost { border-color: rgba(230, 244, 246, 0.5); color: var(--text); }
        .btn--ghost:hover { border-color: var(--cyan); color: var(--cyan); }
        .btn:focus-visible { outline: 2px solid var(--cyan); outline-offset: 3px; }
    </style>
</head>
<body>
    <main class="error">
        <span class="error__mark">
            <img src="{{ asset('admin-assets/logo.webp') }}" alt="Boogi'ink" class="error__logo">
            <svg class="error__ring" viewBox="0 0 52 52" aria-hidden="true"><circle cx="26" cy="26" r="25" pathLength="100"/></svg>
        </span>

        <p class="error__code" aria-hidden="true">{{ status_code }}</p>
        <h1 class="error__title">{% block heading %}Une erreur est survenue{% endblock %}</h1>
        <p class="error__text">{% block text %}Quelque chose s'est mal passé de notre côté. Réessayez dans quelques instants.{% endblock %}</p>

        {% block note %}{% endblock %}

        <div class="error__actions">
            {% if app.user %}
                <a href="{{ path('admin') }}" class="btn btn--primary">Retour au tableau de bord</a>
                <a href="{{ front_url }}" class="btn btn--ghost">Voir le site</a>
            {% else %}
                <a href="{{ front_url }}" class="btn btn--primary">Aller sur le site Boogi'ink</a>
            {% endif %}
        </div>
    </main>
</body>
</html>
